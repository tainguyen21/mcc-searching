# NestJS API database connection string for the local PostGIS container.
DATABASE_URL=postgresql://mcc:mcc_local_only@localhost:5432/mcc
# Shared bearer token for ingestion-to-internal-API calls.
INTERNAL_API_KEY=
# Private NestJS base URL used only by the ingestion worker.
INTERNAL_API_BASE_URL=http://localhost:3001
# NestJS session signing secret for authenticated admin sessions.
SESSION_SECRET=
# NestJS/Next.js revalidation secret for cache invalidation hooks.
REVALIDATION_SECRET=
# Google OAuth client ID consumed by the NestJS auth flow.
GOOGLE_CLIENT_ID=
# Browser-safe Google OAuth client ID consumed by the Next.js app.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Comma-separated admin email allowlist enforced by the API.
ADMIN_EMAIL_ALLOWLIST=
# Browser-safe Mapbox token consumed by the Next.js map UI.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
# Gemini provider API key used by the ingestion worker.
GEMINI_API_KEY=
# Gemini model identifier selected by the ingestion worker.
GEMINI_MODEL=
# Groq provider API key used by the ingestion worker.
GROQ_API_KEY=
# Groq model identifier selected by the ingestion worker.
GROQ_MODEL=
# OpenRouter provider API key used by the ingestion worker.
OPENROUTER_API_KEY=
# OpenRouter model identifier selected by the ingestion worker.
OPENROUTER_MODEL=
# Facebook Graph API token used by the ingestion worker.
FACEBOOK_ACCESS_TOKEN=
# Ingestion mode toggle for Facebook imports.
FACEBOOK_INGESTION_MODE=disabled
# Browser-safe base URL for the NestJS API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
# Browser-safe canonical origin for the Next.js app.
NEXT_PUBLIC_WEB_ORIGIN=http://localhost:3000
